[{"id":126241,"sender_id":11,"sender_full_name":"Urs","avatar_url":"https://secure.gravatar.com/avatar/b00d1ee17463af676c78974439b92471?d=identicon&version=1","content":"<p><a href=\"#narrow/channel/2-Latest-Changes/topic/abelian.20category/near/126241\">#13</a> In the subsection on canonical <span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi mathvariant=\"normal\">A</mi><mi mathvariant=\"normal\">b</mi></mrow><annotation encoding=\"application/x-tex\">\\mathrm{Ab}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord\"><span class=\"mord mathrm\">Ab</span></span></span></span></span>-enrichment (<a href=\"https://ncatlab.org/nlab/show/abelian+category#CanonicalAbEnrichment\">here</a>) I have turned the statement into a numbered proposition with some reformatting, and then added citation to <a href=\"https://ncatlab.org/nlab/show/abelian+category#FreydScedrov1990\">Freyd &amp; Scedrov 1990 §1.597-§1.598</a> and and a streamlined version of their proof.</p>\n<p><a href=\"https://ncatlab.org/nlab/revision/diff/abelian+category/86\">diff</a>, <a href=\"https://ncatlab.org/nlab/revision/abelian+category/86\">v86</a>, <a href=\"https://ncatlab.org/nlab/show/abelian+category\">current</a></p>","timestamp":1792233191,"subject":"abelian category","stream_id":2,"display_recipient":"Latest Changes","reactions":[]}]