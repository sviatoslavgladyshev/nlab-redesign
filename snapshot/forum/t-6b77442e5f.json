\n<li>\n<p><a href=\"https://ncatlab.org/nlab/show/Simon%20Donaldson\">Simon Donaldson</a>, <a href=\"https://ncatlab.org/nlab/show/Peter%20Kronheimer\">Peter Kronheimer</a>: <em>The Geometry of Four-Manifolds</em> (1990, revised 1997), Oxford University Press and Claredon Press, [<a href=\"https://academic.oup.com/book/52942\">oup:52942</a>, <a href=\"https://doi.org/10.1093/oso/9780198535539.001.0001\">doi:10.1093/oso/9780198535539.001.0001</a>, ISBN:978-0198502692, ISSN:0964-9174]</p>\n</li>\n<li>\n<p><a href=\"https://ncatlab.org/nlab/show/Alexandru%20Scorpan\">Alexandru Scorpan</a>, <em>The Wild World of 4-Manifolds</em>, American Mathematical Society (2005) [<a href=\"https://bookstore.ams.org/fourman\">ISBN 978-1470468613</a>]</p>\n</li>\n</ul>\n<p><a href=\"https://ncatlab.org/nlab/revision/diff/Donaldson+invariant/4\">diff</a>, <a href=\"https://ncatlab.org/nlab/revision/Donaldson+invariant/4\">v4</a>, <a href=\"https://ncatlab.org/nlab/show/Donaldson+invariant\">current</a></p>","timestamp":1791880775,"subject":"Donaldson invariant","stream_id":2,"display_recipient":"Latest Changes","reactions":[]},{"id":126227,"sender_id":1024,"sender_full_name":"Samuel Adrian Antz","avatar_url":"https://secure.gravatar.com/avatar/3cf65b33b707c0ede6bb3bfa7f4670cf?d=identicon&version=1","content":"<p><a href=\"#narrow/channel/2-Latest-Changes/topic/Donaldson.20invariant/near/126227\">#5</a> Added references.</p>\n<p><a href=\"https://ncatlab.org/nlab/revision/diff/Donaldson+invariant/4\">diff</a>, <a href=\"https://ncatlab.org/nlab/revision/Donaldson+invariant/4\">v4</a>, <a href=\"https://ncatlab.org/nlab/show/Donaldson+invariant\">current</a></p>","timestamp":1791881361,"subject":"Donaldson invariant","stream_id":2,"display_recipient":"Latest Changes","reactions":[]}]